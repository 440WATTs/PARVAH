# ==============================================================================
# PAHAD SAATHI — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Mode: 'demo' (default, offline-first with IndexedDB persistence) or 'production' (Supabase backend)
VITE_APP_MODE=demo

# Supabase Production Backend (Optional in Demo Mode)
# In demo mode, leave these empty. The app automatically persists data locally via Dexie IndexedDB.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Emergency Notification Gateway (Optional, server-side only in production)
# NEVER expose private Twilio or SMS service keys in client code!
VITE_EMERGENCY_COUNTRY_CODE=+91
VITE_NATIONAL_EMERGENCY_NUMBER=112
VITE_SENIOR_ELDERLINE_NUMBER=14567
